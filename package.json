{
  "name": "beam-yard",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "test": "npm run test -w server",
    "build": "npm run build -w web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
